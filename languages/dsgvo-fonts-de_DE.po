#. Plugin Name of the plugin
#: dsgvo-fonts.php
msgid "DSGVO Fonts"
msgstr ""

#. Description of the plugin
#: dsgvo-fonts.php
msgid "Self-hosts Google Fonts and Font Awesome automatically, so visitors' browsers no longer connect to Google or Font Awesome servers."
msgstr "Hostet Google Fonts und Font Awesome automatisch lokal, damit die Browser der Besucher keine Verbindung mehr zu Google- oder Font-Awesome-Servern aufbauen."

#. Author of the plugin
#: dsgvo-fonts.php
msgid "Anton Lapko"
msgstr ""

#: src/Admin.php:36
#: src/Admin.php:155
msgid "Settings"
msgstr "Einstellungen"

#. translators: %s: name of another font plugin, e.g. OMGF
#: src/Admin.php:57
#, php-format
msgid "%s is active as well. Please deactivate it, so the two plugins don't interfere with each other."
msgstr "%s ist ebenfalls aktiv. Bitte deaktiviere es, damit sich die beiden Plugins nicht gegenseitig in die Quere kommen."

#: src/Admin.php:70
#: src/Admin.php:83
msgid "You are not allowed to do this."
msgstr "Dazu fehlt dir die Berechtigung."

#: src/Admin.php:114
msgid "Google Fonts and Font Awesome are downloaded by your server on the first page view and served locally afterwards. Visitors' browsers don't connect to Google or Font Awesome."
msgstr "Google Fonts und Font Awesome werden beim ersten Seitenaufruf von deinem Server heruntergeladen und anschließend lokal ausgeliefert. Die Browser der Besucher stellen keine Verbindung zu Google oder Font Awesome her."

#: src/Admin.php:117
msgid "The cache was cleared. Fonts are downloaded again on the next page view."
msgstr "Der Cache wurde geleert. Fonts werden beim nächsten Seitenaufruf neu heruntergeladen."

#: src/Admin.php:119
msgid "The page check is complete."
msgstr "Die Seitenprüfung ist abgeschlossen."

#: src/Admin.php:121
msgid "Settings saved. The font cache was cleared."
msgstr "Einstellungen gespeichert. Der Font-Cache wurde geleert."

#: src/Admin.php:124
msgid "Status"
msgstr "Status"

#. translators: 1: number of files, 2: total size, 3: folder
#: src/Admin.php:129
#, php-format
msgid "%1$d local file (%2$s) in %3$s"
msgid_plural "%1$d local files (%2$s) in %3$s"
msgstr[0] "%1$d lokale Datei (%2$s) in %3$s"
msgstr[1] "%1$d lokale Dateien (%2$s) in %3$s"

#: src/Admin.php:142
msgid "Clear cache"
msgstr "Cache leeren"

#: src/Admin.php:145
msgid "Check page"
msgstr "Seite prüfen"

#: src/Admin.php:146
msgid "Loads a page like a visitor who isn't logged in and lists all remaining references to Google Fonts or Font Awesome in its HTML and stylesheets."
msgstr "Ruft eine Seite wie ein nicht angemeldeter Besucher ab und listet alle verbliebenen Verweise auf Google Fonts oder Font Awesome im HTML und in den eingebundenen CSS-Dateien."

#: src/Admin.php:151
msgid "Check"
msgstr "Prüfen"

#: src/Admin.php:160
msgid "Services"
msgstr "Dienste"

#: src/Admin.php:162
msgid "Self-host Google Fonts"
msgstr "Google Fonts lokal hosten"

#: src/Admin.php:163
msgid "Self-host Font Awesome"
msgstr "Font Awesome lokal hosten"

#: src/Admin.php:167
msgid "Subsets (Google Fonts)"
msgstr "Zeichensätze (Google Fonts)"

#: src/Admin.php:172
msgid "If a font offers none of the selected subsets, all of its files are loaded."
msgstr "Bietet eine Schrift keinen der gewählten Zeichensätze an, werden alle ihre Dateien geladen."

#: src/Admin.php:180
msgid "Don't change"
msgstr "Nicht ändern"

#: src/Admin.php:183
msgid "\"swap\" shows text immediately in a fallback font and prevents invisible text while fonts load."
msgstr "„swap“ zeigt Text sofort in einer Ersatzschrift an und verhindert unsichtbaren Text während des Ladens."

#: src/Admin.php:187
msgid "Local stylesheets"
msgstr "Lokale CSS-Dateien"

#: src/Admin.php:189
msgid "Search theme and plugin stylesheets for imports of Google Fonts / Font Awesome and serve cleaned copies"
msgstr "CSS-Dateien von Theme und Plugins nach Einbindungen von Google Fonts / Font Awesome durchsuchen und bereinigte Kopien ausliefern"

#: src/Admin.php:193
msgid "JavaScript guard"
msgstr "JavaScript-Schutz"

#: src/Admin.php:195
msgid "Block Google Fonts and Font Awesome files that are added by JavaScript"
msgstr "Per JavaScript nachgeladene Google-Fonts- und Font-Awesome-Dateien blockieren"

#: src/Admin.php:196
msgid "Applies e.g. to sliders or widgets that add fonts in the browser. These elements then show the fallback font."
msgstr "Greift z. B. bei Slidern oder Widgets, die Schriften erst im Browser einfügen. Diese Elemente zeigen dann die Ersatzschrift."

#: src/Admin.php:200
msgid "Font Awesome Kits"
msgstr "Font Awesome Kits"

#. translators: %s: Font Awesome version number
#: src/Admin.php:207
#, php-format
msgid "Font Awesome Kits (kit scripts) are replaced by a local copy of Font Awesome Free. Leave empty to use the kit's version (fallback: %s). Pro icons and custom kit icons are not included."
msgstr "Font Awesome Kits (Kit-Skripte) werden durch eine lokale Font Awesome Free ersetzt. Leer lassen, um die Version des Kits zu übernehmen (Ersatz: %s). Pro-Icons und eigene Kit-Icons sind nicht enthalten."

#: src/Admin.php:212
msgid "Also load compatibility for Font Awesome 4 classes (fa fa-…)"
msgstr "Kompatibilität für Font-Awesome-4-Klassen (fa fa-…) mitladen"

#: src/Admin.php:216
msgid "Save and clear cache"
msgstr "Speichern und Cache leeren"

#: src/Admin.php:231
msgid "No files localized yet. Visit a page or use \"Check page\"."
msgstr "Noch keine Dateien lokalisiert. Rufe eine Seite auf oder nutze „Seite prüfen“."

#: src/Admin.php:239
msgid "Local stylesheet copy"
msgstr "Lokale CSS-Kopie"

#. translators: %d: number of localized sources
#: src/Admin.php:246
#, php-format
msgid "Show %d localized source"
msgid_plural "Show %d localized sources"
msgstr[0] "%d lokalisierte Quelle anzeigen"
msgstr[1] "%d lokalisierte Quellen anzeigen"

#: src/Admin.php:252
msgid "Type"
msgstr "Typ"

#: src/Admin.php:253
msgid "Source"
msgstr "Quelle"

#: src/Admin.php:254
msgid "Local file"
msgstr "Lokale Datei"

#: src/Admin.php:255
msgid "Date"
msgstr "Datum"

#: src/Admin.php:286
msgid "Notices and errors:"
msgstr "Hinweise und Fehler:"

#. translators: %d: minutes
#: src/Admin.php:289
#, php-format
msgid "Files that can't be downloaded are blocked (the page uses the fallback font) and retried after %d minutes."
msgstr "Nicht ladbare Dateien werden blockiert (die Seite nutzt dann die Ersatzschrift) und nach %d Minuten erneut versucht."

#. translators: 1: checked URL, 2: date and time
#: src/Admin.php:310
#, php-format
msgid "Result for %1$s from %2$s:"
msgstr "Ergebnis für %1$s vom %2$s:"

#. translators: %s: error message
#: src/Admin.php:318
#, php-format
msgid "The page could not be checked: %s"
msgstr "Die Seite konnte nicht geprüft werden: %s"

#: src/Admin.php:324
msgid "No references to Google Fonts or Font Awesome found."
msgstr "Keine Verweise auf Google Fonts oder Font Awesome gefunden."

#. translators: %d: number of references
#: src/Admin.php:334
#, php-format
msgid "%d remaining reference found:"
msgid_plural "%d remaining references found:"
msgstr[0] "%d verbliebener Verweis gefunden:"
msgstr[1] "%d verbliebene Verweise gefunden:"

#: src/Admin.php:343
msgid "References of a service that is disabled in the settings are kept on purpose. If a page cache is active, clear it and check again."
msgstr "Ist ein Dienst in den Einstellungen deaktiviert, bleiben seine Verweise bewusst erhalten. Bei aktivem Seiten-Cache diesen leeren und erneut prüfen."

#: src/Downloader.php:49
msgid "Empty response"
msgstr "Leere Antwort"

#: src/Localizer.php:114
msgid "Unknown file type"
msgstr "Unbekannter Dateityp"

#. translators: %s: file path
#: src/Localizer.php:133
#, php-format
msgid "File could not be saved: %s"
msgstr "Datei konnte nicht gespeichert werden: %s"

#: src/Localizer.php:144
msgid "No @font-face rules in the response from Google"
msgstr "Keine @font-face-Regeln in der Antwort von Google"

#. translators: 1: error message, 2: Font Awesome version number
#: src/Localizer.php:278
#, php-format
msgid "Kit version could not be detected (%1$s), using Font Awesome Free %2$s"
msgstr "Kit-Version nicht ermittelbar (%1$s), verwende Font Awesome Free %2$s"

#: src/Localizer.php:285
msgid "Pro kit detected: Font Awesome Free is provided locally, Pro icons are missing."
msgstr "Pro-Kit erkannt: Lokal wird Font Awesome Free bereitgestellt, Pro-Icons fehlen."

